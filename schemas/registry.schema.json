{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "object",
	"required": ["name", "versions"],
	"properties": {
		"name": {
			"type": "string",
			"pattern": "^(?:[a-z][a-z0-9_-]{1,}[a-z0-9]/)?[a-z](?:[a-z0-9_-]*[a-z0-9])?$",
			"maxLength": 128
		},
		"description": {
			"type": "string"
		},
		"license": {
			"type": "string"
		},
		"authors": {
			"type": "array",
			"items": { "type": "string" }
		},
		"tags": {
			"type": "array",
			"maxItems": 10,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"pattern": "^[a-z][a-z0-9-]{0,31}$"
			}
		},
		"git": {
			"type": "string",
			"format": "uri",
			"pattern": "^(https?://|git@|ssh://)"
		},
		"branch": {
			"type": "string",
			"default": "main"
		},
		"versions": {
			"type": "object",
			"minProperties": 1,
			"propertyNames": {
				"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
			},
			"additionalProperties": {
				"oneOf": [
					{
						"type": "string",
						"pattern": "^[0-9a-f]{40}$",
						"description": "Commit hash for this version, using the portfile's git and branch."
					},
					{
						"type": "object",
						"required": ["commit"],
						"properties": {
							"commit": {
								"type": "string",
								"pattern": "^[0-9a-f]{40}$"
							},
							"git": {
								"type": "string",
								"format": "uri",
								"pattern": "^(https?://|git@|ssh://)"
							},
							"branch": {
								"type": "string"
							},
							"sha256": {
								"$ref": "#/definitions/sha256"
							}
						},
						"additionalProperties": false
					},
					{
						"type": "object",
						"required": ["archive", "sha256"],
						"properties": {
							"archive": {
								"type": "string",
								"format": "uri",
								"pattern": "^https?://"
							},
							"sha256": {
								"$ref": "#/definitions/sha256"
							},
							"size": {
								"type": "integer",
								"minimum": 1
							}
						},
						"additionalProperties": false
					}
				]
			}
		},
		"dependencies": {
			"type": "object",
			"additionalProperties": {
				"type": "string",
				"description": "Version constraint"
			}
		},
		"revoked": {
			"type": "array",
			"uniqueItems": true,
			"items": {
				"type": "string",
				"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
			},
			"description": "Version keys that must not resolve for installs. Each key must exist in `versions`."
		}
	},
	"definitions": {
		"sha256": {
			"type": "string",
			"pattern": "^[0-9a-f]{64}$",
			"description": "SHA-256 of the source artifact (tarball or git archive)."
		}
	},
	"additionalProperties": false
}
