{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"type": "array",
	"items": {
		"type": "object",
		"required": ["name", "git", "latest"],
		"properties": {
			"name": {
				"type": "string"
			},
			"description": {
				"type": ["string", "null"]
			},
			"authors": {
				"type": "array",
				"items": { "type": "string" }
			},
			"latest": {
				"type": ["string", "null"]
			},
			"git": {
				"type": "string",
				"format": "uri"
			},
			"lastUpdated": {
				"type": ["string", "null"],
				"format": "date-time",
				"description": "When a new version was last added to this package."
			},
			"firstPublished": {
				"type": ["string", "null"],
				"format": "date-time",
				"description": "When this package was first published to the registry."
			},
			"approximate": {
				"const": true,
				"description": "Set when the dates were reconstructed from registry history and are estimates."
			}
		},
		"additionalProperties": false
	}
}
